extends layout

block content
  .posts-container
    if posts && posts.length > 0
      each post in posts
        .post-card
          .post-card-left
            h2.post-title= post.title
            p.post-username= post.username
          .post-card-right
            .post-meta-box
              // Filter out null/empty values and join them with a comma
              - var metaInfo = [post.date, post.flair, post.game, post.platform].filter(Boolean).join(', ')
              span= metaInfo
    else
      p No posts available.