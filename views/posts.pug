extends layout

block content
  .posts-container
    if posts && posts.length > 0
      each post in posts
        .post-card
          .post-card-left
            // Clicking the title now takes you to the specific post
            h2.post-title
              a(href='/post/' + post.id)= post.title
            p.post-username= post.username
          .post-card-right
            .post-meta-box
              // Updated to use names instead of raw IDs
              - var metaInfo = [post.date, post.flair, post.game_name, post.platform_name].filter(Boolean).join(', ')
              span= metaInfo
    else
      p No posts available.