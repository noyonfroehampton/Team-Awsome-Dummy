doctype html
html
  head
    title Gamespace
    link(rel="stylesheet", href="/css/styles.css")
  body
    header.banner
      .logo-container
        //- Wrap the image in a link pointing to the root route[cite: 7, 12]
        a(href="/")
          img(src="/images/logo.png", alt="Gamespace Logo")
      
      nav.nav-links
        a(href="/categories") Categories
        a(href="/games") Games List
        a(href="/posts") Posts
      
      .profile-icon
        .circle

    main.container
      block content