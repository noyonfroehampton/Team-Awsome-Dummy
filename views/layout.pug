doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet", href="/static/style.css")
  body
    header.site-header
      //- Group the logo and search bar together
      div.header-left
        div.logo Logo here
        div.search-bar
          input(type="search", placeholder="Search games, guides...")
          
      nav.nav-links
        a(href="#") Tags
        a(href="#") Games list
        a(href="#") FAQs
      
      div.profile-link
        a(href="#", title="Profile Link")
          div.circle
          
    main.container
      block content