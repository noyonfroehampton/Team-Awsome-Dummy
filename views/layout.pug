doctype html
html
  head
    title Gamespace
    link(rel="stylesheet", href="/css/styles.css")
  body
    header.banner
      .logo-container
        img(src="/images/logo.png", alt="Gamespace Logo", class="logo-placeholder")
      nav.nav-links
        form(action="/search" method="GET" class="search-form")
        input(type="text" name="q" placeholder="Search games and posts..." required)
        button(type="submit") Search
        a(href="/categories") Categories
        a(href="/games") Games List
        a(href="/posts") Posts
      .profile-icon
        .circle

    main.container
      block content