extends layout

block content
  //- This new wrapper tells the grid to keep everything grouped together
  div.categories-layout

    //- Platforms Section
    section.box
      h2 Platforms
      div.tag-grid
        each platform in platforms
          a.tag-button(href=`/platforms/${platform.id}`)= platform.name

    //- Tags Section
    section.box
      h2 Tags
      div.tag-grid
        each tag in tags
          a.tag-button(href=`/tags/${tag.id}`)= tag.name