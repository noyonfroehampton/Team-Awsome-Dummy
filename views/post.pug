extends layout

block content
  .post-page-layout
    //- Nickname at the top[cite: 5]
    p.author-nickname= post.nickname

    .post-header-row
      //- Boxed Post Title[cite: 5]
      .title-box
        h1= post.title

      //- Vertical Meta Stack: Flair, Game, Platform, Date[cite: 5]
      .meta-stack
        p= post.Flair_Name || 'General'
        p= post.game_name
        p= post.platform_name
        p= post.post_timestamp

    //- Boxed Description[cite: 5]
    .description-box
      p Post description:
      p.description-text= post.description

    //- Rating Bar[cite: 5]
    .rating-row
      .rating-box
        span Total Rating: #{post.total_rating}

    //- Comments Section[cite: 5]
    .comments-container
      h3 Comments
      if comments && comments.length > 0
        each comment in comments
          .comment-block
            .comment-content
              strong= comment.nickname
              span.timestamp  (#{comment.comment_timestamp})
              p= comment.comment_text
            
            //- Nested Replies Section[cite: 3, 6]
            .replies-list
              each reply in replies
                if reply.comment_id == comment.id
                  .reply-item
                    strong= reply.nickname
                    span.timestamp  (#{reply.reply_timestamp})
                    p= reply.reply_text
      else
        p No comments yet.